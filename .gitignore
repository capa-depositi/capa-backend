# capa-backend .gitignore

# Node dependencies
node_modules/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
pids/
*.pid

# Build / output
dist/
build/

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE/config
.vscode/
.idea/

# Misc
.cache/
